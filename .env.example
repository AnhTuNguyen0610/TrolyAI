# ─── Chọn LLM provider (mặc định: gemini) ───────────────────────────
# gemini | groq | openrouter | ollama | openai
LLM_PROVIDER=gemini

# Chỉ cần điền key của provider bạn chọn:
GOOGLE_API_KEY=        # https://aistudio.google.com/apikey        (miễn phí)
GROQ_API_KEY=          # https://console.groq.com                  (miễn phí)
OPENROUTER_API_KEY=    # https://openrouter.ai/keys                (có model :free)
# Ollama: không cần key — cài https://ollama.com rồi `ollama pull llama3.2`
# OPENAI_API_KEY=      # chỉ khi dùng LLM_PROVIDER=openai (trả phí)

# (tuỳ chọn) đổi model mặc định của provider. Tên model free hay thay đổi,
# nếu gặp lỗi "model not found" hãy kiểm tra lại danh sách model của nhà cung cấp.
# LLM_MODEL=gemini-2.5-flash

# Tìm kiếm web (tool tim_kiem_web) — https://serper.dev có gói miễn phí
SERPER_API_KEY=

# (tuỳ chọn) bật LangSmith để debug
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=TroLy.AI
